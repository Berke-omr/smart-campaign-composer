# Copy to .env to override defaults. Every variable is optional:
# `docker compose up` works without a .env file.

# --- Claude -------------------------------------------------------------------
# Read from phase P3 on. Leave empty to run with the mock LLM.
ANTHROPIC_API_KEY=

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Seed data ----------------------------------------------------------------
SEED_USERS=5000
SEED_RANDOM_SEED=42

# --- Host ports (change if something on your machine already uses them) -------
UI_HOST_PORT=8080
API_HOST_PORT=8081
MOCK_PROVIDER_HOST_PORT=18090
POSTGRES_HOST_PORT=55432
