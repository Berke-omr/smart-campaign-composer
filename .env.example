# Copy to .env to override defaults. Every variable is optional:
# `docker compose up` works without a .env file.

# --- Claude -------------------------------------------------------------------
# Leave the key empty to run with the mock LLM (no API calls).
ANTHROPIC_API_KEY=
# auto: Claude when ANTHROPIC_API_KEY is set, the mock LLM otherwise.
# anthropic: always Claude (startup fails without a key). mock: never calls the API.
LLM_PROVIDER=auto
LLM_MODEL=claude-sonnet-5-5

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Mock SMS/email provider faults -------------------------------------------
# Fractions of requests (0-1). 503 + 429 + slow together are at most 1.
MOCK_LATENCY_MIN=20ms
MOCK_LATENCY_MAX=120ms
MOCK_ERROR_RATE=0.03
MOCK_THROTTLE_RATE=0.03
# Accepted, but answered after MOCK_SLOW_DELAY: the sender times out and retries.
MOCK_SLOW_RATE=0.005
MOCK_SLOW_DELAY=10s
# Rejected as invalid (400), decided by recipient: never retried.
MOCK_REJECT_RATE=0.01
# Requests per channel in any 1-second window; 0 turns the limit off.
MOCK_RATE_LIMIT=100

# --- Seed data ----------------------------------------------------------------
SEED_USERS=5000
SEED_RANDOM_SEED=42

# --- Host ports (change if something on your machine already uses them) -------
UI_HOST_PORT=8080
API_HOST_PORT=8081
MOCK_PROVIDER_HOST_PORT=18090
POSTGRES_HOST_PORT=55432
